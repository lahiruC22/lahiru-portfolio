---
interface Competency {
  title: string;
  description: string;
  icon: string;
  iconAlt: string;
}

const competencies: Competency[] = [
  {
    title: 'Backend Engineering',
    description:
      'Building secure, scalable REST APIs and robust database schemas using Go, Python, and Rust to power modern, high-performance applications.',
    icon: '/icon-backend.svg',
    iconAlt: 'Database icon',
  },
  {
    title: 'Distributed Systems',
    description:
      'Implementing containerised environments and decoupled architectures using Docker, Kubernetes, and Kafka for resilient, scalable infrastructure.',
    icon: '/icon-distributed.svg',
    iconAlt: 'Cloud infrastructure icon',
  },
  {
    title: 'AI/ML Integration',
    description:
      'Integrating machine learning models and APIs into backend services using PyTorch and TensorFlow to create intelligent, data-driven applications.',
    icon: '/icon-aiml.svg',
    iconAlt: 'AI brain icon',
  },
];
---

<section class="bg-surface py-20">
  <div class="mx-auto max-w-7xl px-6">
    <!-- Section header -->
    <div class="border-outline-variant/25 mb-14 border-t pt-16">
      <h2 class="font-display text-on-surface text-4xl leading-tight font-bold tracking-tight">
        Core Competencies
      </h2>
    </div>

    <!-- Responsive 3-column grid -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        competencies.map((item) => (
          <div class="border-outline-variant/30 bg-surface-container-high flex h-full flex-col gap-6 rounded-xl border p-10">
            <div class="bg-primary-container/12 flex size-18 shrink-0 items-center justify-center rounded-lg">
              <img src={item.icon} alt={item.iconAlt} width="32" height="32" loading="lazy" />
            </div>

            <div class="flex flex-col gap-3">
              <h3 class="font-display text-on-surface text-xl leading-7 font-bold">{item.title}</h3>
              <p class="font-display text-on-surface-variant text-base leading-6 font-normal">
                {item.description}
              </p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
