---
import type { PortfolioProject } from '../../lib/content';

interface Props {
  projects: PortfolioProject[];
}

const { projects } = Astro.props;
---

<div class="grid grid-cols-1 gap-5 md:grid-cols-2">
  {
    projects.map((project, index) => (
      <article
        id={project.id}
        class="border-outline bg-surface flex h-full flex-col rounded-lg border p-6"
        data-reveal
        data-hover-lift
        style={`--reveal-delay: ${index * 80}ms`}
      >
        <div class="flex flex-wrap items-center justify-between gap-3">
          <p class="text-on-surface-dim font-mono text-xs">0{index + 1}</p>
          <p class="text-accent border-accent/25 rounded-full border px-2 py-1 font-mono text-[0.68rem]">
            {project.type}
          </p>
        </div>
        <h2 class="font-heading text-primary mt-5 text-2xl leading-tight font-medium">
          {project.name}
        </h2>
        <p class="font-body text-on-surface-variant mt-3 text-sm leading-6">{project.summary}</p>

        {project.technologies.length > 0 && (
          <ul class="mt-5 flex flex-wrap gap-2" aria-label="Technologies">
            {project.technologies.map((technology) => (
              <li class="text-accent bg-background rounded-sm px-2 py-1 font-mono text-xs">
                {technology}
              </li>
            ))}
          </ul>
        )}

        {project.contributions.length > 0 && (
          <ul class="mt-5 space-y-3">
            {project.contributions.map((contribution) => (
              <li class="font-body text-on-surface-variant flex items-start gap-3 text-sm leading-6">
                <span class="bg-accent mt-2 size-1.5 shrink-0 rounded-full" />
                <span>{contribution}</span>
              </li>
            ))}
          </ul>
        )}
      </article>
    ))
  }
</div>
