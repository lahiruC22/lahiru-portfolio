---
import TextLink from '../ui/TextLink.astro';
import { profile } from '../../lib/content';
---

<footer class="border-outline mt-20 border-t py-10">
  <div class="mx-auto grid max-w-[72rem] gap-8 px-5 text-sm sm:px-8 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="text-primary font-heading text-lg font-medium">{profile.name}</p>
      <p class="text-on-surface-dim mt-2 max-w-sm leading-6">
        {profile.headline}
      </p>
    </div>

    <nav aria-label="Footer navigation" class="grid grid-cols-2 gap-x-4 gap-y-2 md:grid-cols-1">
      <TextLink href="/">Home</TextLink>
      <TextLink href="/projects">Projects</TextLink>
      <TextLink href="/research">Research</TextLink>
      <TextLink href="/blog">Writing</TextLink>
      <TextLink href="/experience">About</TextLink>
      <TextLink href="/contact">Contact</TextLink>
    </nav>

    <nav aria-label="Footer external links" class="flex flex-col items-start gap-2">
      <TextLink href={profile.contact.github} external>GitHub</TextLink>
      <TextLink href={profile.contact.linkedin} external>LinkedIn</TextLink>
      <TextLink href={`mailto:${profile.contact.email}`}>Email</TextLink>
    </nav>
  </div>
  <div
    class="text-on-surface-dim border-outline mx-auto mt-8 flex max-w-[72rem] flex-col gap-2 border-t px-5 pt-6 text-xs sm:px-8 md:flex-row md:items-center md:justify-between"
  >
    <p>© 2026 {profile.name}</p>
    <p>Built with Astro</p>
  </div>
</footer>
