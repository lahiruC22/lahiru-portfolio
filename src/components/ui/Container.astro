---
interface Props {
  size?: 'content' | 'reading';
  class?: string;
}

const { size = 'content', class: className = '' } = Astro.props;
---

<div
  class:list={[
    'mx-auto w-full px-5 sm:px-8',
    size === 'content' ? 'max-w-[var(--container-content)]' : 'max-w-[var(--container-reading)]',
    className,
  ]}
>
  <slot />
</div>
