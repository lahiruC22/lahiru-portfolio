---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
  class?: string;
}

const { eyebrow, title, description, align = 'left', class: className = '' } = Astro.props;
---

<header class:list={['max-w-3xl', align === 'center' && 'mx-auto text-center', className]}>
  {eyebrow && <p class="text-accent font-mono text-xs tracking-[0.18em] uppercase">{eyebrow}</p>}
  <h2
    class:list={['font-heading text-primary mt-3 text-3xl leading-tight font-medium sm:text-4xl']}
  >
    {title}
  </h2>
  {description && <p class="text-on-surface-variant mt-4 text-base leading-7">{description}</p>}
</header>
