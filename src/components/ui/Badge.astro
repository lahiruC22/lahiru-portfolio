---
interface Props {
  tone?: 'neutral' | 'accent' | 'success' | 'warning' | 'error';
  class?: string;
}

const { tone = 'neutral', class: className = '' } = Astro.props;

const tones = {
  neutral: 'border-outline bg-surface text-on-surface-variant',
  accent: 'border-accent/30 bg-accent/10 text-accent',
  success: 'border-success/30 bg-success-bg text-success',
  warning: 'border-warning/30 bg-warning-bg text-warning',
  error: 'border-error/30 bg-error-bg text-error',
} as const;
---

<span
  class={`inline-flex items-center rounded-full border px-2.5 py-1 font-mono text-[0.6875rem] leading-none ${tones[tone]} ${className}`.trim()}
>
  <slot />
</span>
