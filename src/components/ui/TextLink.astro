---
interface Props {
  href: string;
  external?: boolean;
  class?: string;
  ariaLabel?: string;
}

const { href, external = false, class: className = '', ariaLabel } = Astro.props;
---

<a
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noreferrer' : undefined}
  class={`text-primary hover:text-accent font-mono text-sm underline decoration-outline underline-offset-4 transition-colors duration-150 ${className}`.trim()}
  aria-label={ariaLabel}
>
  <slot />
</a>
