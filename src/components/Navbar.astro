---
import { profile } from '../lib/content';

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/experience', label: 'Experience' },
  { href: '/projects', label: 'Projects' },
  { href: '/research', label: 'Research' },
  { href: '/blog', label: 'Writing' },
] as const;

const currentPath = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);
---

<header
  class="border-outline/80 bg-background/92 sticky top-0 right-0 left-0 z-50 border-b backdrop-blur-xl"
>
  <div class="mx-auto flex h-16 max-w-[72rem] items-center justify-between px-5 sm:px-8">
    <a
      href="/"
      class="text-primary hover:text-accent font-mono text-sm font-semibold tracking-tight transition-colors"
      aria-label={`${profile.name} - Home`}
    >
      {profile.name.split(' ')[0].toLowerCase()}<span class="text-accent">.</span>dev
    </a>

    <nav aria-label="Primary navigation" class="hidden items-center gap-1 lg:flex">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'relative px-3 py-2 font-mono text-xs transition-colors',
              isActive(item.href)
                ? 'text-primary after:bg-accent after:absolute after:right-3 after:bottom-0 after:left-3 after:h-px'
                : 'text-on-surface-variant hover:text-primary',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href="/contact"
        class="border-outline bg-surface text-primary hover:border-accent hover:text-accent ml-3 rounded-md border px-3 py-2 font-mono text-xs transition-colors"
      >
        Let&rsquo;s talk
      </a>
    </nav>

    <button
      id="mobile-menu-button"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="border-outline text-on-surface-variant hover:border-accent hover:text-primary rounded-md border px-3 py-2 font-mono text-xs transition-colors lg:hidden"
    >
      <span id="mobile-menu-label">Menu</span>
    </button>
  </div>

  <nav
    id="mobile-menu"
    aria-label="Mobile navigation"
    class="border-outline bg-background fixed inset-x-0 top-16 hidden max-h-[calc(100dvh-4rem)] overflow-y-auto border-t px-5 py-5 lg:hidden"
  >
    <ul class="divide-outline divide-y">
      {
        navItems.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'mobile-nav-link block py-4 font-mono text-sm transition-colors',
                isActive(item.href) ? 'text-accent' : 'text-on-surface-variant hover:text-primary',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <a
      href="/contact"
      class="mobile-nav-link bg-accent text-background mt-5 flex h-11 items-center justify-center rounded-md font-mono text-sm font-semibold"
    >
      Let&rsquo;s talk
    </a>
  </nav>
</header>

<script>
  const setupMobileNavigation = () => {
    const button = document.getElementById('mobile-menu-button');
    const menu = document.getElementById('mobile-menu');
    const label = document.getElementById('mobile-menu-label');

    if (!button || !menu || !label) return;

    const setMenuOpen = (open: boolean, restoreFocus = true) => {
      button.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'Close' : 'Menu';
      menu.classList.toggle('hidden', !open);
      document.body.classList.toggle('overflow-hidden', open);

      if (open) {
        const firstLink = menu.querySelector<HTMLAnchorElement>('a');
        firstLink?.focus();
      } else if (restoreFocus) {
        button.focus();
      }
    };

    button.onclick = () => {
      setMenuOpen(button.getAttribute('aria-expanded') !== 'true');
    };

    menu.querySelectorAll<HTMLAnchorElement>('.mobile-nav-link').forEach((link) => {
      link.onclick = () => setMenuOpen(false, false);
    });

    document.onkeydown = (event) => {
      if (event.key === 'Escape' && button.getAttribute('aria-expanded') === 'true') {
        setMenuOpen(false, false);
      }

      if (event.key !== 'Tab' || button.getAttribute('aria-expanded') !== 'true') return;

      const focusable = Array.from(
        menu.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')
      );
      if (!focusable.length) return;

      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    };

    setMenuOpen(false, false);
  };

  setupMobileNavigation();
  document.addEventListener('astro:page-load', setupMobileNavigation);
</script>
