---
import Layout from '../layouts/Layout.astro';
import { writingArticles } from '../lib/content';

const formatDate = (date: string) =>
  new Intl.DateTimeFormat('en', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC',
  }).format(new Date(`${date}T00:00:00Z`));
---

<Layout
  title="Writing"
  description="A curated index of my published Medium articles on software engineering, backend systems, and applied AI."
>
  <section class="py-12 sm:py-16">
    <div class="mx-auto w-full max-w-6xl">
      <header class="max-w-3xl" data-fade-in style="--reveal-delay: 60ms">
        <p class="text-accent font-mono text-xs tracking-[0.18em] uppercase">Engineering writing</p>
        <h1
          class="font-heading text-primary mt-3 text-5xl leading-tight font-medium"
          transition:name="page-title"
        >
          Writing
        </h1>
        <p
          class="font-body text-on-surface-variant mt-4 text-base leading-7"
          transition:name="page-subtitle"
        >
          A curated index of my published Medium articles. Summaries live here; the full articles
          are published on Medium.
        </p>
      </header>

      {
        writingArticles.length ? (
          <div class="mt-10 grid grid-cols-1 gap-5 md:grid-cols-2">
            {writingArticles.map((post, index) => (
              <article
                id={post.slug}
                data-reveal
                style={`--reveal-delay: ${index * 110}ms`}
                class="border-outline bg-surface flex min-h-72 flex-col rounded-lg border p-6"
              >
                <div class="flex flex-wrap items-center justify-between gap-3">
                  {post.publishedAt && (
                    <time datetime={post.publishedAt} class="text-on-surface-dim font-mono text-xs">
                      {formatDate(post.publishedAt)}
                    </time>
                  )}
                  {post.readingTime && (
                    <span class="text-accent font-mono text-xs">{post.readingTime}</span>
                  )}
                </div>
                <h2 class="font-heading text-primary mt-6 text-2xl leading-tight font-medium">
                  {post.title}
                </h2>
                <p class="font-body text-on-surface-variant mt-3 text-sm leading-6">
                  {post.summary}
                </p>
                <div class="mt-5 flex flex-wrap gap-2">
                  {post.tags.map((tag) => (
                    <span class="text-accent bg-background rounded-sm px-2 py-1 font-mono text-xs">
                      {tag}
                    </span>
                  ))}
                </div>
                <a
                  href={post.mediumUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-primary hover:text-accent mt-auto inline-flex pt-6 font-mono text-xs"
                >
                  Read on Medium{' '}
                  <span class="ml-2" aria-hidden="true">
                    ↗
                  </span>
                </a>
              </article>
            ))}
          </div>
        ) : (
          <div class="border-outline bg-surface mt-10 max-w-3xl rounded-lg border p-6 sm:p-8">
            <h2 class="font-heading text-primary text-2xl font-medium">
              No articles published yet
            </h2>
            <p class="font-body text-on-surface-variant mt-3 text-base leading-7">
              This page will feature selected Medium publications once they are live.
            </p>
          </div>
        )
      }

      <section class="mt-14 max-w-3xl" data-reveal style="--reveal-delay: 180ms">
        <h2 class="font-heading text-primary text-2xl font-medium">Related pages</h2>
        <div class="mt-4 flex flex-wrap gap-4">
          <a
            href="/research"
            class="font-body text-primary hover:text-accent text-sm transition-colors duration-200"
          >
            Research
          </a>
          <a
            href="/projects"
            class="font-body text-primary hover:text-accent text-sm transition-colors duration-200"
          >
            Projects
          </a>
        </div>
      </section>
    </div>
  </section>
</Layout>
