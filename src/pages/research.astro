---
import Layout from '../layouts/Layout.astro';
import {
  activeResearch,
  completedResearch,
  plannedResearch,
  researchInterests as interests,
  researchPublications as publications,
} from '../lib/content';
---

<Layout
  title="Research"
  description="Completed academic research, publications, current interests, and active and planned research."
>
  <section class="py-12 sm:py-16">
    <div class="mx-auto max-w-6xl">
      <header class="grid gap-8 lg:grid-cols-[1fr_18rem]" data-fade-in>
        <div>
          <p class="text-accent font-mono text-xs tracking-[0.18em] uppercase">Research</p>
          <h1
            class="font-heading text-primary mt-4 max-w-4xl text-5xl leading-[0.98] font-medium sm:text-6xl"
            transition:name="page-title"
          >
            Research at the boundary of AI and systems.
          </h1>
          <p
            class="font-body text-on-surface-variant mt-6 max-w-3xl text-lg leading-8"
            transition:name="page-subtitle"
          >
            Completed academic work comes first, followed by the formal publication record, current
            interests, and ongoing directions.
          </p>
        </div>
        <aside class="border-outline bg-surface h-fit rounded-lg border p-5">
          <p class="text-on-surface-dim font-mono text-xs">Research record</p>
          <dl class="divide-outline mt-4 divide-y">
            <div class="py-3">
              <dt class="text-on-surface-dim font-mono text-[0.68rem] uppercase">Completed</dt>
              <dd class="text-on-surface mt-1 text-sm">
                {completedResearch.length} academic research project{
                  completedResearch.length === 1 ? '' : 's'
                }
              </dd>
            </div>
            <div class="py-3">
              <dt class="text-on-surface-dim font-mono text-[0.68rem] uppercase">Publications</dt>
              <dd class="text-on-surface mt-1 text-sm">
                {publications.length ? publications.length : 'None listed'}
              </dd>
            </div>
            <div class="py-3">
              <dt class="text-on-surface-dim font-mono text-[0.68rem] uppercase">Active</dt>
              <dd class="text-on-surface mt-1 text-sm">{activeResearch.length} direction</dd>
            </div>
            <div class="py-3">
              <dt class="text-on-surface-dim font-mono text-[0.68rem] uppercase">Planned</dt>
              <dd class="text-on-surface mt-1 text-sm">{plannedResearch.length} directions</dd>
            </div>
          </dl>
        </aside>
      </header>

      <section
        class="border-outline mt-16 border-t pt-12"
        aria-labelledby="completed-research-heading"
        data-reveal
      >
        <p class="text-accent font-mono text-xs tracking-[0.18em] uppercase">
          01 / Completed academic research
        </p>
        <h2
          id="completed-research-heading"
          class="font-heading text-primary mt-3 text-3xl font-medium sm:text-4xl"
        >
          Completed research
        </h2>
        <div class="mt-8 space-y-5">
          {
            completedResearch.map((project, index) => (
              <article class="border-outline bg-surface rounded-lg border p-6 sm:p-8">
                <p class="text-accent font-mono text-xs">Research 0{index + 1} · Completed</p>
                <h3 class="font-heading text-primary mt-4 text-2xl font-medium">{project.title}</h3>
                <p class="font-body text-on-surface-variant mt-3 max-w-4xl text-sm leading-6">
                  {project.summary}
                </p>
                {project.caseStudy && (
                  <dl class="mt-5 grid gap-5 md:grid-cols-2">
                    <div>
                      <dt class="text-accent font-mono text-[0.68rem] uppercase">Research focus</dt>
                      <dd class="font-body text-on-surface mt-2 text-sm leading-6">
                        {project.caseStudy.problemStatement}
                      </dd>
                    </div>
                    <div>
                      <dt class="text-accent font-mono text-[0.68rem] uppercase">Approach</dt>
                      <dd class="font-body text-on-surface-variant mt-2 text-sm leading-6">
                        {project.caseStudy.methodology}
                      </dd>
                    </div>
                  </dl>
                )}
                <a
                  href={`/research/${project.id}`}
                  class="text-primary hover:text-accent mt-5 inline-block font-mono text-xs"
                >
                  Read research write-up →
                </a>
              </article>
            ))
          }
        </div>
      </section>

      <section
        class="border-outline mt-16 border-t pt-12"
        aria-labelledby="publications-heading"
        data-reveal
      >
        <p class="text-accent font-mono text-xs tracking-[0.18em] uppercase">
          02 / Formal publications
        </p>
        <h2
          id="publications-heading"
          class="font-heading text-primary mt-3 text-3xl font-medium sm:text-4xl"
        >
          Publications
        </h2>
        {
          publications.length > 0 ? (
            <ul class="mt-8 space-y-4">
              {publications.map((publication) => (
                <li class="border-outline bg-surface rounded-lg border p-6">
                  <h3 class="font-heading text-primary text-xl font-medium">{publication.title}</h3>
                  <p class="text-on-surface-variant mt-2 text-sm">
                    {publication.authors} · {publication.venue} · {publication.year}
                  </p>
                </li>
              ))}
            </ul>
          ) : (
            <p class="font-body text-on-surface-variant border-outline bg-surface mt-8 rounded-lg border p-6 text-sm leading-6">
              No formal publications are currently listed.
            </p>
          )
        }
      </section>

      <section
        class="border-outline mt-16 border-t pt-12"
        aria-labelledby="interests-heading"
        data-reveal
      >
        <p class="text-accent font-mono text-xs tracking-[0.18em] uppercase">
          03 / Research interests
        </p>
        <h2
          id="interests-heading"
          class="font-heading text-primary mt-3 text-3xl font-medium sm:text-4xl"
        >
          Current areas of inquiry
        </h2>
        <div
          class="border-outline bg-outline mt-8 grid gap-px overflow-hidden rounded-lg border md:grid-cols-2"
        >
          {
            interests.map((interest, index) => (
              <article class="bg-surface p-6 sm:p-8">
                <p class="text-accent font-mono text-xs">0{index + 1}</p>
                <h3 class="font-heading text-primary mt-6 text-xl font-medium">{interest.title}</h3>
                <p class="font-body text-on-surface-variant mt-3 text-sm leading-6">
                  {interest.description}
                </p>
              </article>
            ))
          }
        </div>
      </section>

      <section
        class="border-outline mt-16 border-t pt-12"
        aria-labelledby="active-research-heading"
        data-reveal
      >
        <p class="text-accent font-mono text-xs tracking-[0.18em] uppercase">
          04 / Ongoing directions
        </p>
        <h2
          id="active-research-heading"
          class="font-heading text-primary mt-3 text-3xl font-medium sm:text-4xl"
        >
          Active and planned research
        </h2>
        <div class="mt-8 space-y-12">
          {
            [
              { title: 'Active research', projects: activeResearch },
              { title: 'Planned research', projects: plannedResearch },
            ].map((group) => (
              <section aria-label={group.title}>
                <h3 class="font-heading text-primary text-2xl font-medium">{group.title}</h3>
                <div class="mt-5 space-y-5">
                  {group.projects.map((project) => (
                    <article class="border-outline bg-surface rounded-lg border p-6 sm:p-8">
                      <h4 class="font-heading text-primary text-xl font-medium">{project.title}</h4>
                      <dl class="mt-5 grid gap-5 md:grid-cols-2">
                        <div>
                          <dt class="text-accent font-mono text-[0.68rem] uppercase">
                            Research focus
                          </dt>
                          <dd class="font-body text-on-surface-variant mt-2 text-sm leading-6">
                            {project.problem}
                          </dd>
                        </div>
                        <div>
                          <dt class="text-accent font-mono text-[0.68rem] uppercase">Approach</dt>
                          <dd class="font-body text-on-surface-variant mt-2 text-sm leading-6">
                            {project.methodology}
                          </dd>
                        </div>
                      </dl>
                    </article>
                  ))}
                </div>
              </section>
            ))
          }
        </div>
      </section>

      <section class="border-outline bg-surface mt-16 rounded-lg border p-6 sm:p-8" data-reveal>
        <p class="text-accent font-mono text-xs tracking-[0.18em] uppercase">Collaboration</p>
        <h2 class="font-heading text-primary mt-3 text-3xl font-medium">
          Open to applied engineering research.
        </h2>
        <p class="font-body text-on-surface-variant mt-4 max-w-3xl text-base leading-7">
          Interested in reliability-focused experimentation, AI system evaluation, and work that
          connects research questions to production constraints.
        </p>
        <a
          href="/contact"
          class="text-primary hover:text-accent mt-6 inline-block font-mono text-xs"
        >
          Start a conversation →
        </a>
      </section>
    </div>
  </section>
</Layout>
