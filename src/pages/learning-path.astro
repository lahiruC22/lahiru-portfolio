---
import Layout from '../layouts/Layout.astro';
import LearningPathGenerator from '../components/LearningPathGenerator.astro';
---

<Layout
  title="Learning Path Generator"
  description="Generate a reading path from published Medium articles."
>
  <div class="mx-auto w-full max-w-6xl py-12 sm:py-16">
    <header class="max-w-3xl" data-fade-in style="--reveal-delay: 60ms">
      <p class="text-accent font-mono text-xs tracking-[0.18em] uppercase">Interactive tool</p>
      <h1 class="font-heading text-primary mt-3 text-5xl leading-tight font-medium">
        Learning Path Generator
      </h1>
      <p class="font-body text-on-surface-variant mt-4 text-base leading-7">
        Choose a topic or engineering goal to build a focused reading sequence from published
        articles.
      </p>
    </header>
    <div class="mt-10">
      <LearningPathGenerator />
    </div>
  </div>
</Layout>
