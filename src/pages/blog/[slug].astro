---
import Layout from '../../layouts/Layout.astro';
import { blogMetadata } from '../../lib/blogMetadata';

interface BlogPost {
  slug: string;
  title: string;
  date: string;
  readingTime: string;
  summary: string;
  tags: string[];
  sections: { id: string; title: string; paragraphs: string[] }[];
  codeExample?: { label: string; language: string; code: string };
}

export const posts: BlogPost[] = [
  {
    slug: 'idempotency-patterns-event-driven-services',
    title: 'Idempotency Patterns for Event-Driven Services',
    date: '2026-04-10',
    readingTime: '7 min read',
    summary:
      'Designing event workflows that remain correct under retries, duplicates, and partial failures.',
    tags: ['event-driven', 'backend', 'reliability'],
    sections: [
      {
        id: 'why-idempotency-matters',
        title: 'Why idempotency matters',
        paragraphs: [
          'Idempotency is less about deduplication and more about deterministic state transitions. In event-driven systems, retries are unavoidable; predictable behavior is not optional.',
        ],
      },
      {
        id: 'scoped-operation',
        title: 'Scope the operation',
        paragraphs: [
          'A practical strategy is to pair an idempotency key with a scoped business operation. Persist the key with operation status, then treat all repeated requests as state lookups rather than re-executions.',
        ],
      },
      {
        id: 'durable-workflows',
        title: 'Make workflows durable',
        paragraphs: [
          'When this is combined with durable event logs and explicit compensation logic, services become resilient to transport-level uncertainty without sacrificing throughput.',
        ],
      },
    ],
    codeExample: {
      label: 'Conceptual idempotency pattern',
      language: 'pseudocode',
      code: `state = lookup(idempotencyKey, operationScope)

if state is COMPLETED:
  return state.result

if state is IN_PROGRESS:
  return existingWork(state)

persist(IN_PROGRESS)
result = execute(operation)
persist(COMPLETED, result)
return result`,
    },
  },
  {
    slug: 'diagnosing-slow-api-paths-incremental-profiling',
    title: 'Diagnosing Slow API Paths with Incremental Profiling',
    date: '2026-03-28',
    readingTime: '6 min read',
    summary:
      'A stepwise method for reducing latency blind spots across application and database boundaries.',
    tags: ['performance', 'profiling', 'go'],
    sections: [
      {
        id: 'evidence-first',
        title: 'Start with evidence',
        paragraphs: [
          'Latency incidents are often misdiagnosed because teams jump straight to optimization before understanding path-level cost. Incremental profiling enforces evidence-first tuning.',
        ],
      },
      {
        id: 'locate-variance',
        title: 'Locate the variance',
        paragraphs: [
          'Start with coarse-grained tracing to locate high variance endpoints. Then move to targeted CPU and allocation profiles in production-like traffic windows.',
        ],
      },
      {
        id: 'encode-performance',
        title: 'Encode the performance budget',
        paragraphs: [
          'The final step is to codify findings into performance budgets and alerts, so regressions are detected before users notice them.',
        ],
      },
    ],
  },
  {
    slug: 'practical-trade-offs-kubernetes-autoscaling',
    title: 'Practical Trade-offs in Kubernetes Autoscaling',
    date: '2026-03-14',
    readingTime: '8 min read',
    summary: 'Balancing cost, latency, and stability when designing autoscaling policies.',
    tags: ['kubernetes', 'sre', 'platform'],
    sections: [
      {
        id: 'control-system',
        title: 'Treat scaling as a control system',
        paragraphs: [
          'Autoscaling is a control system, not a toggle. Poorly tuned thresholds can create oscillations that increase cost while degrading reliability.',
        ],
      },
      {
        id: 'characterize-workload',
        title: 'Characterize the workload',
        paragraphs: [
          'Right-sizing starts with workload characterization: burst profile, warm-up latency, and dependency saturation points. Then choose metrics aligned with user-perceived performance.',
        ],
      },
      {
        id: 'coordinate-scaling',
        title: 'Coordinate scaling strategies',
        paragraphs: [
          'Stability improves when horizontal and vertical scaling strategies are coordinated instead of configured independently.',
        ],
      },
    ],
  },
  {
    slug: 'prototype-to-production-serving-ml-models-safely',
    title: 'From Prototype to Production: Serving ML Models Safely',
    date: '2026-02-25',
    readingTime: '9 min read',
    summary: 'Operational guardrails that turn model demos into reliable production services.',
    tags: ['mlops', 'ai', 'production'],
    sections: [
      {
        id: 'production-is-infrastructure',
        title: 'Production serving is infrastructure',
        paragraphs: [
          'Production model serving is an infrastructure problem as much as a modeling problem. Versioning, observability, and rollback policies are foundational.',
        ],
      },
      {
        id: 'safe-rollout',
        title: 'Design a safe rollout',
        paragraphs: [
          'Safe rollout paths include shadow traffic, canary percentages, and confidence-based fallback logic. Each step should have explicit SLO gates.',
        ],
      },
      {
        id: 'monitor-drift',
        title: 'Instrument drift early',
        paragraphs: [
          'Teams that instrument drift and data quality checks early avoid expensive downstream debugging once model behavior changes in real traffic.',
        ],
      },
    ],
  },
];

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: BlogPost };

const postIndex = posts.findIndex((item) => item.slug === post.slug);
const previousPost = postIndex > 0 ? posts[postIndex - 1] : null;
const nextPost = postIndex >= 0 && postIndex < posts.length - 1 ? posts[postIndex + 1] : null;
const metadata = blogMetadata.find((item) => item.slug === post.slug);

const relatedPosts = posts
  .filter((item) => item.slug !== post.slug)
  .map((item) => ({
    post: item,
    overlap: item.tags.filter((tag) => post.tags.includes(tag)).length,
  }))
  .sort((a, b) => b.overlap - a.overlap)
  .slice(0, 2)
  .map((item) => item.post);

const tocItems = [
  { id: 'article-overview', title: 'Overview' },
  ...post.sections.map((section) => ({ id: section.id, title: section.title })),
  { id: 'key-takeaways', title: 'Key takeaways' },
];
---

<Layout title={post.title} description={post.summary} ogType="article" publishedTime={post.date}>
  <div
    id="reading-progress"
    class="bg-accent fixed top-16 right-0 left-0 z-60 h-0.5 origin-left scale-x-0"
    role="progressbar"
    aria-label="Reading progress"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
  >
  </div>
  <section class="py-10 sm:py-14">
    <div class="mx-auto max-w-6xl">
      <nav aria-label="Breadcrumb" class="text-on-surface-dim font-mono text-xs">
        <a href="/blog" class="hover:text-primary transition-colors">Writing</a>
        <span aria-hidden="true"> / </span>
        <span>{post.title}</span>
      </nav>

      <header class="mx-auto mt-8 max-w-3xl text-center sm:mt-12" data-fade-in>
        <p class="text-accent font-mono text-xs tracking-[0.18em] uppercase">Technical note</p>
        <h1
          class="font-heading text-primary mt-4 text-4xl leading-[1.02] font-medium sm:text-5xl lg:text-6xl"
        >
          {post.title}
        </h1>
        <p class="font-body text-on-surface-variant mt-6 text-lg leading-8">{post.summary}</p>
        <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
          <time datetime={post.date} class="text-on-surface-dim font-mono text-xs">
            {
              new Intl.DateTimeFormat('en', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
                timeZone: 'UTC',
              }).format(new Date(`${post.date}T00:00:00Z`))
            }
          </time>
          <span class="text-outline-variant" aria-hidden="true">·</span>
          <span class="text-accent font-mono text-xs">{post.readingTime}</span>
        </div>
        <div class="mt-5 flex flex-wrap justify-center gap-2">
          {
            post.tags.map((tag) => (
              <span class="text-accent bg-background rounded-md px-2.5 py-1.5 font-mono text-xs">
                {tag}
              </span>
            ))
          }
        </div>
      </header>

      <div class="mt-12 grid w-full max-w-full min-w-0 items-start gap-10 lg:grid-cols-[12rem_1fr]">
        <aside
          class="border-outline bg-surface w-full max-w-full min-w-0 overflow-hidden rounded-lg border p-4 lg:sticky lg:top-24"
          aria-label="Table of contents"
        >
          <p class="text-on-surface-dim pb-3 font-mono text-[0.68rem] uppercase">On this page</p>
          <nav
            class="flex max-w-full gap-2 overflow-x-auto pb-1 lg:block lg:space-y-1 lg:overflow-visible lg:pb-0"
          >
            {
              tocItems.map((item) => (
                <a
                  href={`#${item.id}`}
                  class="text-on-surface-variant hover:text-primary shrink-0 rounded-md px-2 py-2 font-mono text-xs transition-colors lg:block"
                >
                  {item.title}
                </a>
              ))
            }
          </nav>
        </aside>

        <article
          id="article-overview"
          class="article-prose w-full max-w-full min-w-0 scroll-mt-24"
          data-reveal
        >
          <p class="text-on-surface text-xl leading-8 sm:text-2xl sm:leading-9">
            {post.summary}
          </p>

          {
            post.sections.map((section) => (
              <section id={section.id} class="scroll-mt-24">
                <h2>{section.title}</h2>
                {section.paragraphs.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </section>
            ))
          }

          {
            post.codeExample && (
              <section class="mt-10">
                <h2>{post.codeExample.label}</h2>
                <div class="code-block border-outline bg-background-secondary relative w-full max-w-full overflow-hidden rounded-lg border">
                  <div class="border-outline flex items-center justify-between border-b px-4 py-3">
                    <span class="text-on-surface-dim font-mono text-xs">
                      {post.codeExample.language}
                    </span>
                    <button
                      type="button"
                      data-copy-code
                      class="text-on-surface-variant hover:text-accent font-mono text-xs transition-colors"
                      aria-label={`Copy ${post.codeExample.label}`}
                    >
                      Copy
                    </button>
                  </div>
                  <pre class="overflow-x-auto p-4 sm:p-5">
                    <code>{post.codeExample.code}</code>
                  </pre>
                </div>
              </section>
            )
          }

          {
            metadata && (
              <section id="key-takeaways" class="scroll-mt-24">
                <h2>Key takeaways</h2>
                <ul>
                  {metadata.keyTakeaways.map((takeaway) => (
                    <li>{takeaway}</li>
                  ))}
                </ul>
              </section>
            )
          }
        </article>
      </div>

      {
        relatedPosts.length > 0 && (
          <section class="border-outline mt-16 border-t pt-10" data-reveal>
            <p class="text-accent font-mono text-xs tracking-[0.18em] uppercase">Related reading</p>
            <h2 class="font-heading text-primary mt-3 text-3xl font-medium">Continue with</h2>
            <div class="mt-6 grid gap-4 md:grid-cols-2">
              {relatedPosts.map((related) => (
                <a
                  href={`/blog/${related.slug}`}
                  class="border-outline bg-surface hover:border-accent/50 rounded-lg border p-5 transition-colors"
                >
                  <p class="text-on-surface-dim font-mono text-xs">{related.readingTime}</p>
                  <h3 class="font-heading text-primary mt-3 text-xl font-medium">
                    {related.title}
                  </h3>
                  <p class="font-body text-on-surface-variant mt-3 text-sm leading-6">
                    {related.summary}
                  </p>
                </a>
              ))}
            </div>
          </section>
        )
      }

      <nav
        class="border-outline bg-outline mt-12 grid gap-px overflow-hidden rounded-lg border md:grid-cols-2"
        aria-label="Previous and next articles"
      >
        {
          previousPost ? (
            <a href={`/blog/${previousPost.slug}`} class="bg-surface p-5 sm:p-6">
              <p class="text-on-surface-dim font-mono text-xs">← Previous</p>
              <p class="font-heading text-primary mt-2 text-lg font-medium">{previousPost.title}</p>
            </a>
          ) : (
            <span class="bg-surface p-5 sm:p-6" />
          )
        }
        {
          nextPost ? (
            <a
              href={`/blog/${nextPost.slug}`}
              class="bg-surface p-5 text-left sm:p-6 md:text-right"
            >
              <p class="text-on-surface-dim font-mono text-xs">Next →</p>
              <p class="font-heading text-primary mt-2 text-lg font-medium">{nextPost.title}</p>
            </a>
          ) : (
            <span class="bg-surface p-5 sm:p-6" />
          )
        }
      </nav>
    </div>
  </section>
</Layout>

<script>
  const setupArticleEnhancements = () => {
    const progress = document.getElementById('reading-progress');
    const article = document.querySelector<HTMLElement>('.article-prose');

    const updateProgress = () => {
      if (!progress || !article) return;
      const rect = article.getBoundingClientRect();
      const readableDistance = Math.max(article.offsetHeight - window.innerHeight * 0.25, 1);
      const read = Math.min(
        Math.max((window.innerHeight * 0.25 - rect.top) / readableDistance, 0),
        1
      );
      progress.style.transform = `scaleX(${read})`;
      progress.setAttribute('aria-valuenow', String(Math.round(read * 100)));
    };

    updateProgress();
    window.addEventListener('scroll', updateProgress, { passive: true });

    document.querySelectorAll<HTMLButtonElement>('[data-copy-code]').forEach((button) => {
      button.onclick = async () => {
        const block = button.closest('.code-block')?.querySelector('code');
        if (!block) return;
        const text = block.textContent ?? '';
        let copied = false;
        try {
          if (navigator.clipboard && window.isSecureContext) {
            await navigator.clipboard.writeText(text);
            copied = true;
          } else {
            const textarea = document.createElement('textarea');
            textarea.value = text;
            textarea.setAttribute('readonly', '');
            textarea.style.position = 'fixed';
            textarea.style.opacity = '0';
            document.body.append(textarea);
            textarea.select();
            copied = document.execCommand('copy');
            textarea.remove();
          }
          if (!copied) throw new Error('Copy not supported');
          button.textContent = 'Copied';
          window.setTimeout(() => {
            button.textContent = 'Copy';
          }, 1600);
        } catch {
          const range = document.createRange();
          range.selectNodeContents(block);
          const selection = window.getSelection();
          selection?.removeAllRanges();
          selection?.addRange(range);
          button.textContent = 'Text selected';
        }
      };
    });
  };

  setupArticleEnhancements();
  document.addEventListener('astro:page-load', setupArticleEnhancements);
</script>
