---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/sections/Footer.astro';

const capabilities = [
  {
    number: '01',
    title: 'Backend systems',
    description: 'APIs, data access, idempotency, concurrency, and fault-tolerant service design.',
  },
  {
    number: '02',
    title: 'Distributed infrastructure',
    description: 'Containers, orchestration, messaging, tracing, and operational ownership.',
  },
  {
    number: '03',
    title: 'Applied AI',
    description: 'Model integration, retrieval, evaluation, and production model-serving patterns.',
  },
] as const;

const researchTracks = [
  'Reliable AI systems in production',
  'Evaluation and benchmark design',
  'Distributed systems for ML workloads',
] as const;
---

<Layout
  title="Home"
  description="Lahiru Wimalarathna is a software engineer working across backend systems, distributed infrastructure, and applied AI."
>
  <section
    class="grid min-h-[calc(100vh-6rem)] items-center gap-12 py-16 lg:grid-cols-[1.25fr_0.75fr] lg:py-24"
  >
    <div>
      <p class="text-accent font-mono text-xs tracking-[0.18em] uppercase" data-fade-in>
        Software Engineer · AI/ML · Backend
      </p>
      <h1
        class="font-heading text-primary mt-5 max-w-4xl text-5xl leading-[1.02] font-medium sm:text-6xl lg:text-[5.25rem]"
        data-fade-in
        style="--reveal-delay: 80ms"
      >
        Building reliable intelligent systems.
      </h1>
      <p
        class="font-body text-on-surface-variant mt-7 max-w-2xl text-lg leading-8"
        data-fade-in
        style="--reveal-delay: 160ms"
      >
        I work across backend architecture, distributed systems, and applied AI — with attention to
        observability, evaluation, and production reliability.
      </p>
      <div
        class="mt-9 flex flex-wrap items-center gap-3"
        data-fade-in
        style="--reveal-delay: 240ms"
      >
        <a
          href="/projects"
          class="bg-primary text-background hover:bg-accent-bright rounded-md px-5 py-3 font-mono text-sm font-semibold transition-colors"
        >
          View projects
        </a>
        <a
          href="/experience"
          class="border-outline text-primary hover:border-accent rounded-md border px-5 py-3 font-mono text-sm transition-colors"
        >
          Experience
        </a>
        <a
          href="/contact"
          class="text-on-surface-variant hover:text-primary px-2 py-3 font-mono text-sm transition-colors"
        >
          Get in touch →
        </a>
      </div>
    </div>

    <aside
      class="border-outline bg-surface rounded-lg border p-5 shadow-(--shadow-soft)"
      data-reveal
      style="--reveal-delay: 160ms"
    >
      <div class="border-outline flex items-center justify-between border-b pb-4">
        <span class="text-on-surface-dim font-mono text-xs">system profile</span>
        <span class="text-accent flex items-center gap-2 font-mono text-xs">
          <span class="bg-accent size-1.5 rounded-full"></span>
          active
        </span>
      </div>
      <dl class="divide-outline mt-2 divide-y">
        <div class="grid grid-cols-[7rem_1fr] gap-4 py-4">
          <dt class="text-on-surface-dim font-mono text-xs">focus</dt>
          <dd class="text-on-surface text-sm">AI + infrastructure</dd>
        </div>
        <div class="grid grid-cols-[7rem_1fr] gap-4 py-4">
          <dt class="text-on-surface-dim font-mono text-xs">based in</dt>
          <dd class="text-on-surface text-sm">Sri Lanka</dd>
        </div>
        <div class="grid grid-cols-[7rem_1fr] gap-4 py-4">
          <dt class="text-on-surface-dim font-mono text-xs">open to</dt>
          <dd class="text-on-surface text-sm">Engineering + research</dd>
        </div>
      </dl>
    </aside>
  </section>

  <section class="border-outline border-t py-16" data-reveal>
    <div class="mb-8 flex items-end justify-between gap-6">
      <div>
        <p class="text-accent font-mono text-xs tracking-[0.18em] uppercase">Capabilities</p>
        <h2 class="font-heading text-primary mt-3 text-3xl font-medium sm:text-4xl">
          What I build
        </h2>
      </div>
    </div>
    <div
      class="border-outline bg-outline grid gap-px overflow-hidden rounded-lg border md:grid-cols-3"
    >
      {
        capabilities.map((item) => (
          <article class="bg-surface p-6 sm:p-8" data-hover-lift>
            <p class="text-accent font-mono text-xs">{item.number}</p>
            <h3 class="font-heading text-primary mt-8 text-xl font-medium">{item.title}</h3>
            <p class="font-body text-on-surface-variant mt-3 text-sm leading-6">
              {item.description}
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="grid gap-10 py-16 lg:grid-cols-[1fr_0.65fr]" data-reveal>
    <div>
      <p class="text-accent font-mono text-xs tracking-[0.18em] uppercase">Research direction</p>
      <h2 class="font-heading text-primary mt-3 max-w-2xl text-3xl font-medium sm:text-4xl">
        Questions that shape the work
      </h2>
      <ul class="border-outline mt-7 divide-y border-y">
        {
          researchTracks.map((track, index) => (
            <li class="grid grid-cols-[2.5rem_1fr] items-center gap-3 py-5">
              <span class="text-on-surface-dim font-mono text-xs">0{index + 1}</span>
              <span class="text-on-surface text-base">{track}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <aside class="border-outline bg-surface-raised rounded-lg border p-7">
      <p class="text-terminal font-mono text-xs tracking-[0.16em] uppercase">Collaboration</p>
      <p class="font-body text-on-surface-variant mt-4 text-base leading-7">
        Open to applied research, engineering collaborations, and roles focused on AI systems,
        backend infrastructure, or distributed platforms.
      </p>
      <a href="/contact" class="text-primary hover:text-accent mt-6 inline-block font-mono text-sm">
        Start a conversation →
      </a>
    </aside>
  </section>

  <Footer />
</Layout>
