---
import Layout from '../../layouts/Layout.astro';
import type { PortfolioProject } from '../../lib/content';
import { portfolioProjects } from '../../lib/content';

export function getStaticPaths() {
  return portfolioProjects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props as { project: PortfolioProject };
---

<Layout title={project.name} description={project.summary} ogType="article">
  <section class="py-12 sm:py-16">
    <div class="mx-auto max-w-4xl">
      <nav aria-label="Breadcrumb" class="text-on-surface-dim font-mono text-xs">
        <a href="/projects" class="hover:text-primary transition-colors">Projects</a>
        <span aria-hidden="true"> / </span>
        <span>{project.type}</span>
      </nav>

      <header class="mt-7" data-fade-in>
        <p class="text-accent font-mono text-xs tracking-[0.18em] uppercase">
          {project.type}
        </p>
        <h1
          class="font-heading text-primary mt-4 text-4xl leading-[1.02] font-medium sm:text-5xl lg:text-6xl"
          transition:name="page-title"
        >
          {project.name}
        </h1>
        <p
          class="font-body text-on-surface-variant mt-6 max-w-3xl text-lg leading-8"
          transition:name="page-subtitle"
        >
          {project.summary}
        </p>
      </header>

      {
        project.technologies.length > 0 && (
          <section
            class="border-outline mt-12 border-t pt-8"
            aria-labelledby="technologies-heading"
          >
            <h2
              id="technologies-heading"
              class="text-accent font-mono text-xs tracking-[0.18em] uppercase"
            >
              Technologies
            </h2>
            <ul class="mt-5 flex flex-wrap gap-2">
              {project.technologies.map((technology) => (
                <li class="text-accent bg-surface border-outline rounded-md border px-2.5 py-1.5 font-mono text-xs">
                  {technology}
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        project.contributions.length > 0 && (
          <section
            class="border-outline mt-12 border-t pt-8"
            aria-labelledby="contributions-heading"
          >
            <h2 id="contributions-heading" class="font-heading text-primary text-3xl font-medium">
              Contributions
            </h2>
            <ul class="mt-5 space-y-3">
              {project.contributions.map((contribution) => (
                <li class="border-outline bg-surface flex items-start gap-3 rounded-md border p-5">
                  <span class="bg-accent mt-2 size-1.5 shrink-0 rounded-full" />
                  <span class="font-body text-on-surface-variant text-sm leading-6">
                    {contribution}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <footer class="border-outline mt-14 flex flex-wrap gap-5 border-t pt-8">
        <a href="/projects" class="text-primary hover:text-accent font-mono text-xs">
          ← Back to projects
        </a>
        <a href="/contact" class="text-primary hover:text-accent font-mono text-xs">
          Discuss this work →
        </a>
      </footer>
    </div>
  </section>
</Layout>
