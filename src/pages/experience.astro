---
import Layout from '../layouts/Layout.astro';
import ExperienceSection from '../components/sections/ExperienceSection.astro';
import {
  certifications,
  education,
  experiences,
  profile,
  skillCategories,
  formatPeriod,
} from '../lib/content';
---

<Layout
  title="About"
  description="Professional profile, academic background, experience, skills, and certifications."
>
  <section class="py-12 sm:py-16">
    <div class="mx-auto max-w-6xl">
      <header class="grid w-full min-w-0 gap-8 lg:grid-cols-[1fr_18rem]" data-fade-in>
        <div class="min-w-0">
          <p class="text-accent font-mono text-xs tracking-[0.18em] uppercase">
            01 / Professional profile
          </p>
          <h1
            class="font-heading text-primary mt-4 max-w-4xl text-4xl leading-[0.98] font-medium sm:text-5xl lg:text-6xl"
            transition:name="page-title"
          >
            About Me
          </h1>
          <p
            class="font-body text-on-surface-variant mt-6 max-w-3xl text-lg leading-8"
            transition:name="page-subtitle"
          >
            {profile.summary}
          </p>
        </div>
        <aside class="border-outline bg-surface h-fit rounded-lg border p-5">
          <p class="text-on-surface-dim font-mono text-xs">Profile</p>
          <dl class="divide-outline mt-4 divide-y">
            <div class="py-3">
              <dt class="text-on-surface-dim font-mono text-[0.68rem] uppercase">Location</dt>
              <dd class="text-on-surface mt-1 text-sm">{profile.location}</dd>
            </div>
            <div class="py-3">
              <dt class="text-on-surface-dim font-mono text-[0.68rem] uppercase">Headline</dt>
              <dd class="text-on-surface mt-1 text-sm">{profile.headline}</dd>
            </div>
          </dl>
        </aside>
      </header>

      <section class="border-outline mt-16 border-t pt-12" data-reveal>
        <p class="text-accent font-mono text-xs tracking-[0.18em] uppercase">
          02 / Academic background
        </p>
        <h2 class="font-heading text-primary mt-3 text-3xl font-medium sm:text-4xl">Education</h2>
        <div class="mt-8 space-y-5">
          {
            education.map((entry) => (
              <article
                id={entry.id}
                class="border-outline bg-surface grid gap-5 rounded-lg border p-6 sm:p-8 md:grid-cols-[12rem_1fr]"
              >
                <div>
                  <p class="text-on-surface-dim font-mono text-xs">
                    {formatPeriod(entry.startDate, entry.endDate)}
                  </p>
                  <p class="text-accent mt-2 font-mono text-[0.68rem] uppercase">Degree</p>
                </div>
                <div>
                  <h3 class="font-heading text-primary text-2xl font-medium">
                    {entry.qualification}
                  </h3>
                  <p class="text-on-surface-variant mt-2 text-sm">
                    {entry.institution} · {entry.location}
                  </p>
                  <div class="mt-4 flex flex-wrap gap-5">
                    <p class="text-on-surface text-sm">
                      <span class="text-on-surface-dim">GPA</span> · {entry.gpa}
                    </p>
                    <p class="text-on-surface text-sm">
                      <span class="text-on-surface-dim">Classification</span> ·{' '}
                      {entry.classification}
                    </p>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section class="border-outline mt-16 border-t pt-12" data-reveal>
        <p class="text-accent font-mono text-xs tracking-[0.18em] uppercase">
          03 / Professional experience
        </p>
        <div class="flex items-end justify-between gap-6">
          <h2 class="font-heading text-primary mt-3 text-3xl font-medium sm:text-4xl">
            My timeline
          </h2>
          <a
            href="/projects"
            class="text-on-surface-variant hover:text-primary hidden font-mono text-xs sm:block"
          >
            Project work →
          </a>
        </div>
        <div class="mt-8">
          <ExperienceSection experiences={experiences} />
        </div>
      </section>

      <section class="border-outline mt-16 border-t pt-12" data-reveal>
        <p class="text-accent font-mono text-xs tracking-[0.18em] uppercase">
          04 / Technical skills
        </p>
        <h2 class="font-heading text-primary mt-3 text-3xl font-medium sm:text-4xl">
          Tools and technologies
        </h2>
        <div class="divide-outline border-outline mt-8 divide-y border-y">
          {
            skillCategories.map((category) => (
              <article class="grid gap-4 py-6 md:grid-cols-[14rem_1fr] md:gap-8">
                <h3 class="font-heading text-primary text-xl font-medium">{category.name}</h3>
                <ul class="flex flex-wrap gap-2">
                  {category.items.map((item) => (
                    <li class="text-accent bg-surface border-outline rounded-md border px-2.5 py-1.5 font-mono text-xs">
                      {item}
                    </li>
                  ))}
                </ul>
              </article>
            ))
          }
        </div>
      </section>

      <section class="border-outline mt-16 border-t pt-12" data-reveal>
        <p class="text-accent font-mono text-xs tracking-[0.18em] uppercase">
          05 / Areas of interest
        </p>
        <h2 class="font-heading text-primary mt-3 text-3xl font-medium sm:text-4xl">
          Ongoing interests
        </h2>
        <div
          class="border-outline bg-outline mt-8 grid gap-px overflow-hidden rounded-lg border sm:grid-cols-2"
        >
          {
            profile.interests.map((interest, index) => (
              <article class="bg-surface p-5 sm:p-6">
                <p class="text-accent font-mono text-xs">0{index + 1}</p>
                <p class="font-heading text-primary mt-5 text-lg font-medium">{interest}</p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="border-outline mt-16 border-t pt-12" data-reveal>
        <p class="text-accent font-mono text-xs tracking-[0.18em] uppercase">06 / Certifications</p>
        <h2 class="font-heading text-primary mt-3 text-3xl font-medium sm:text-4xl">
          Course certifications
        </h2>
        <div class="mt-8 grid gap-4 md:grid-cols-2">
          {
            certifications.map((certification) => (
              <article class="border-outline bg-surface rounded-lg border p-6">
                <h3 class="font-heading text-primary text-xl font-medium">{certification.name}</h3>
                {certification.issuer && (
                  <p class="text-on-surface-variant mt-2 text-sm">{certification.issuer}</p>
                )}
                {certification.date && (
                  <p class="text-on-surface-dim mt-3 font-mono text-xs">{certification.date}</p>
                )}
                {certification.verificationUrl && (
                  <a
                    href={certification.verificationUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-primary hover:text-accent mt-4 inline-block font-mono text-xs"
                  >
                    Verify credential ↗
                  </a>
                )}
              </article>
            ))
          }
        </div>
      </section>

      <section class="border-outline bg-surface mt-16 rounded-lg border p-6 sm:p-8" data-reveal>
        <p class="text-accent font-mono text-xs tracking-[0.18em] uppercase">Connect</p>
        <h2 class="font-heading text-primary mt-3 text-3xl font-medium">
          Open to engineering and research collaboration.
        </h2>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href="/contact"
            class="bg-primary text-background hover:bg-accent-bright inline-flex h-12 items-center rounded-md px-5 font-mono text-sm font-semibold transition-colors"
          >
            Contact Me
          </a>
          <a
            href="/projects"
            class="border-outline text-primary hover:border-accent inline-flex h-12 items-center rounded-md border px-5 font-mono text-sm transition-colors"
          >
            View projects
          </a>
        </div>
      </section>
    </div>
  </section>
</Layout>
