---
import Layout from '../layouts/Layout.astro';
import ExperienceSection from '../components/sections/ExperienceSection.astro';
import { experiences } from '../lib/content';
---

<Layout title="Experience" description="Employment history and selected product contributions.">
  <section class="py-12 sm:py-16">
    <div class="mx-auto max-w-6xl">
      <header class="max-w-3xl" data-fade-in>
        <p class="text-accent font-mono text-xs tracking-[0.18em] uppercase">
          Professional experience
        </p>
        <h1
          class="font-heading text-primary mt-4 text-4xl leading-[0.98] font-medium sm:text-5xl lg:text-6xl"
          transition:name="page-title"
        >
          Experience
        </h1>
        <p
          class="font-body text-on-surface-variant mt-6 text-lg leading-8"
          transition:name="page-subtitle"
        >
          Employment history, with roles and contributions organized by employer and product.
        </p>
        <a href="/about" class="text-primary hover:text-accent mt-5 inline-block font-mono text-xs">
          About me →
        </a>
      </header>

      <section class="border-outline mt-12 border-t pt-10" aria-label="Employment timeline">
        <ExperienceSection experiences={experiences} />
      </section>

      <section class="border-outline bg-surface mt-16 rounded-lg border p-6 sm:p-8" data-reveal>
        <p class="text-accent font-mono text-xs tracking-[0.18em] uppercase">Next</p>
        <h2 class="font-heading text-primary mt-3 text-3xl font-medium">
          Explore projects and selected work.
        </h2>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href="/projects"
            class="bg-primary text-background hover:bg-accent-bright inline-flex h-12 items-center rounded-md px-5 font-mono text-sm font-semibold transition-colors"
          >
            View projects
          </a>
          <a
            href="/contact"
            class="border-outline text-primary hover:border-accent inline-flex h-12 items-center rounded-md border px-5 font-mono text-sm transition-colors"
          >
            Contact Me
          </a>
        </div>
      </section>
    </div>
  </section>
</Layout>
