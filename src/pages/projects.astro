---
import Layout from '../layouts/Layout.astro';
import ProjectSection from '../components/sections/ProjectSection.astro';
import { portfolioProjects } from '../lib/content';
---

<Layout title="Projects" description="Personal, freelance, and analytical project work.">
  <section class="py-20">
    <div class="mx-auto max-w-5xl">
      <header class="mb-10" data-fade-in style="--reveal-delay: 60ms">
        <p class="text-accent font-mono text-xs tracking-[0.18em] uppercase">Selected work</p>
        <h1
          class="font-heading text-primary mt-3 text-5xl leading-tight font-medium"
          transition:name="page-title"
        >
          Projects
        </h1>
        <p
          class="font-body text-on-surface-variant mt-4 max-w-170 text-base leading-7"
          transition:name="page-subtitle"
        >
          Personal, freelance, and data-analysis work, with contributions and technologies
          documented from the portfolio source data.
        </p>
      </header>

      <ProjectSection projects={portfolioProjects} />
    </div>
  </section>
</Layout>
